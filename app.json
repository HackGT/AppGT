{
  "expo": {
    "name": "HexLabs",
    "slug": "AppGT",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Logo.png",
    "scheme": "appgt",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/Logo.png",
      "bundleIdentifier": "gt.hack.AppGT",
      "buildNumber": "3",
      "deploymentTarget": "17.0",
      "entitlements": {
        "com.apple.developer.nfc.readersession.formats": [
          "TAG"
        ]
      },
      "appleTeamId": "8B3884J679",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to scan QR codes for event check-in.",
        "NSMicrophoneUsageDescription": "Required by the camera framework but not actively used.",
        "NFCReaderUsageDescription": "Used to read and write NFC badges for event check-in."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/Logo.png"
      },
      "compileSdkVersion": 35,
      "predictiveBackGestureEnabled": false,
      "androidStatusBar": { "translucent": false, "backgroundColor": "#ffffff" },
      "versionCode": 3,
      "package": "com.appgt",
      "permissions": [
        "android.permission.NFC",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/Logo.png",
          "imageWidth": 200
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Used to read and write NFC badges for event check-in.",
          "includeNdefEntitlement": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow HexLabs to access your camera to scan QR codes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
