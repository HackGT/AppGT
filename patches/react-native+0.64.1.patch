     # it's better to rely on platform name as fallback because architecture differs between simulator and device
 
     if [[ "$PLATFORM_NAME" == *"simulator"* ]]; then
-        CURRENT_ARCH="x86_64"
+        CURRENT_ARCH="arm64"
     else
-        CURRENT_ARCH="armv7"
+        CURRENT_ARCH="arm64"
     fi
 fi
 
